{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "map-veto",
  "main": "worker.ts",
  "compatibility_date": "2025-06-03",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "services": [{ "binding": "SERVER", "service": "map-veto-server" }]
}
